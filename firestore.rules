rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // USERS — each user can only access their own profile
    // ============================================
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || resource.data.isPublic == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================
    // TOURNAMENTS — public collection for invite links
    // Anyone can read (so unauthenticated users can see the join page before logging in).
    // Only the organizer can create/update the tournament doc.
    // Any authenticated user can update ONLY the participants array (to join).
    // ============================================
    match /tournaments/{tournamentId} {
      // Anyone can read (needed for /join/:id before login)
      allow read: if true;

      // Organizer can create new tournaments (Guests cannot)
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.organizerId == request.auth.uid;

      // Organizer can do full updates; any authenticated user can update participants array (join)
      allow update: if request.auth != null && (
        // Organizer can update anything
        resource.data.organizerId == request.auth.uid
        // OR: any auth user can update the participants list (to join tournament)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
      );

      allow delete: if request.auth != null
                    && resource.data.organizerId == request.auth.uid;
    }

    // ============================================
    // LEAGUES
    // ============================================
    match /leagues/{leagueId} {
      // Anyone can read (needed for discoverability and invite code lookup)
      allow read: if true;

      // Authenticated non-guest users can create leagues
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.organizerId == request.auth.uid;

      // Any authenticated user can update (join league via memberIds, or trigger recalc)
      // In a strict prod environment, we would limit which fields can be edited by non-organizers.
      allow update: if request.auth != null;

      // Only organizer can delete
      allow delete: if request.auth != null
                    && resource.data.organizerId == request.auth.uid;
    }

    // ============================================
    // DEFAULT: deny everything else
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
