rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================
    // USERS — each user can only access their own profile
    // ============================================
    match /users/{userId} {
      allow read: if (request.auth != null && request.auth.uid == userId) || resource.data.isPublic == true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // ============================================
    // TOURNAMENTS — public collection for invite links
    // Anyone can read (so unauthenticated users can see the join page before logging in).
    // Only the organizer can create/update the tournament doc.
    // Any authenticated user can update ONLY the participants array (to join).
    // ============================================
    match /tournaments/{tournamentId} {
      // Anyone can read (needed for /join/:id before login)
      allow read: if true;

      // Organizer can create new tournaments (Guests cannot)
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.organizerId == request.auth.uid;

      // Organizer can do full updates; any authenticated user can update participants array (join)
      allow update: if request.auth != null && (
        // Organizer can update anything
        resource.data.organizerId == request.auth.uid
        // OR: any auth user can update the participants list (to join tournament)
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants'])
      );

      allow delete: if request.auth != null
                    && resource.data.organizerId == request.auth.uid;
    }

    // ============================================
    // LEAGUES
    // ============================================
    match /leagues/{leagueId} {
      // Anyone can read (needed for discoverability and invite code lookup)
      allow read: if true;

      // Authenticated non-guest users can create leagues
      allow create: if request.auth != null
                    && request.auth.token.firebase.sign_in_provider != 'anonymous'
                    && request.resource.data.organizerId == request.auth.uid;

      // Any authenticated user can update (join league via memberIds, or trigger recalc)
      // In a strict prod environment, we would limit which fields can be edited by non-organizers.
      allow update: if request.auth != null;

      // Only organizer can delete
      allow delete: if request.auth != null
                    && resource.data.organizerId == request.auth.uid;
                    
      // ============================================
      // LEAGUE SUBCOLLECTIONS
      // ============================================
      
      match /members/{memberId} {
        allow read: if true;
        // User can add themselves (join) if auth.uid == memberId. Organizer can edit anyone (ban).
        allow write: if request.auth != null && (request.auth.uid == memberId || get(/databases/$(database)/documents/leagues/$(leagueId)).data.organizerId == request.auth.uid);
      }

      match /audit_log/{logId} {
        allow read: if true;
        // Any auth user can create an audit log (e.g. when joining).
        allow create: if request.auth != null;
        // Audit logs are immutable
        allow update, delete: if false; 
      }

      match /organizers/{orgId} {
        allow read: if true;
        // Only the league organizer can add/remove other organizers
        allow write: if request.auth != null && get(/databases/$(database)/documents/leagues/$(leagueId)).data.organizerId == request.auth.uid;
      }

      match /seasons/{seasonId} {
        allow read: if true;
        // Only the league organizer can archive/manage seasons
        allow write: if request.auth != null && get(/databases/$(database)/documents/leagues/$(leagueId)).data.organizerId == request.auth.uid;
      }
    }

    // ============================================
    // DEFAULT: deny everything else
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
